###################################################
# Runtime mode
###################################################
# llm_only = DOM, with no screenshots.
# vlm_only = DOM plus screenshots.
AGENT_BRAIN_MODE=llm_only
# AGENT_BRAIN_MODE=vlm_only

# Enable/disable endpoints. The selected mode's endpoint must be enabled.
LLM_ENABLED=1
VLM_ENABLED=0

# Shared key fallback; uncomment an endpoint-specific key below if needed.
OPENAI_API_KEY=local

###################################################
# Survey target / version / condition
###################################################
# Root URL of survey-benchmark.
SURVEY_TARGET=http://127.0.0.1:3001
SURVEY_VERSION=v0
SURVEY_OCCURRENCE=o1
# This runner currently supports o1 only.

# Theme-only o1: 11 substantive questions, no embedded attention checks.
# All themes run in manifest order. Or list theme names in your preferred order.
SURVEY_THEMES=all
# SURVEY_THEMES=consumer digital wellbeing education work finance civic lifestyle
# SURVEY_THEMES=work

# Finish all orders/repeats for one theme before moving to the next.
# 1 = 24 runs/model (8 x 3). Set to 5 for 120 runs/model (8 x 3 x 5).
SURVEY_REPEATS=1

# Uncomment one orders line.
SURVEY_ORDERS=order01 order02 order03
# SURVEY_ORDERS=order01
# SURVEY_ORDERS=order02
# SURVEY_ORDERS=order03

###################################################
# LLM models: uncomment exactly one LLM_MODEL
###################################################
# Use the exact ID returned by `python agent.py models`.
# LLM_MODEL=meta-llama-3-8b-instruct
# LLM_MODEL=mistral-7b-instruct-v0.3
# LLM_MODEL=qwen2.5-7b-instruct-1m
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# LM Studio endpoint
LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=local
LLM_TEMPERATURE=0

###################################################
# VLM models: inactive while AGENT_BRAIN_MODE=llm_only
###################################################
# Before using: switch to vlm_only, set VLM_ENABLED=1, and uncomment exactly one VLM_MODEL below.
# VLM_MODEL=qwen2.5-vl-7b-instruct
# VLM_MODEL=llava-1.6-mistral-7b
# VLM_MODEL=minicpm-v-2_6

VLM_BASE_URL=http://127.0.0.1:1234/v1
# VLM_API_KEY=local
VLM_TEMPERATURE=0

###################################################
# Output / prompt behavior
###################################################
# Empty MODEL_NAME automatically uses the selected model ID for the folder.
# You only need to change LLM_MODEL when switching models.
MODEL_NAME=
# MODEL_NAME=mistral-7b-instruct-v0.3

# Results: runs/<model_name>/o1_<theme>/<batch>/run-<index>-<order>-repeat-<n>/
# Relative paths resolve against the Agentic directory.
AGENTIC_RUNS_DIR=runs
AGENTIC_DB_PATH=../survey-benchmark/benchmark.sqlite
